# Copy this file to .env and configure one provider only.
# Never commit the resulting .env file or any real credentials.

# -----------------------------------------------------------------------------
# Optional: Hugging Face authentication for downloading the embedding model
# BAAI/bge-m3 is public, so the experiment also works without this token.
# Authentication provides higher download rate limits and may improve speed.
# -----------------------------------------------------------------------------
HF_TOKEN=

# -----------------------------------------------------------------------------
# Option A: OpenAI-compatible infrastructure used in the manuscript
# -----------------------------------------------------------------------------
REMOTE_API_URL=https://server.example/v1
REMOTE_API_KEY=replace_with_your_key
REMOTE_MODEL=gpt-oss

# -----------------------------------------------------------------------------
# Option B: Groq fallback
# Leave blank when using the OpenAI-compatible provider above.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
